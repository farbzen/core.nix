# settings

(map-type "map-plane")
(viewpoint-x 0.5)
(viewpoint-y 0.5)
(viewpoint-z 2)
(position-x 0.5)
(position-y 0.5)
(position-z 0)
(first-axis-x 1)
(first-axis-y 0)
(first-axis-z 0)
(second-axis-x 0)
(second-axis-y 1)
(second-axis-z 0)
(rotation-angle-x 0)
(rotation-angle-y 0)
(rotation-angle-z 0)
(light-type "point-light")
(light-color
    (color "R'G'B'A float" 16 "\0\0\200\77\0\0\200\77\0\0\200\77\0\0\200\77" 0))
(light-position-x -0.5)
(light-position-y -0.5)
(light-position-z 2)
(light-direction-x -1)
(light-direction-y -1)
(light-direction-z 1)
(ambient-intensity 0.29999999999999999)
(diffuse-intensity 1)
(diffuse-reflectivity 0.5)
(specular-reflectivity 0.5)
(highlight 27)
(antialiasing yes)
(depth 3)
(threshold 0.25)
(tiled no)
(new-image no)
(new-layer no)
(transparent-background no)
(sphere-radius 0.25)
(x-scale 0.5)
(y-scale 0.5)
(z-scale 0.5)
(cylinder-radius 0.25)
(cylinder-length 0.25)

# end of settings
